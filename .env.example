# ---------- FREE SETUP (recommended) ----------

# Free: writes the summaries. Get one at aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=your_gemini_key

# Free: transcribes audio files. Get one at console.groq.com/keys
# If you skip Gemini, this key also writes summaries (fine for meetings up to ~30-40 min).
GROQ_API_KEY=your_groq_key

# Pick any password once the app is online, so strangers can't use up your free limits.
APP_PASSWORD=pick_a_password

# ---------- OPTIONAL PAID UPGRADE ----------

# If set, Claude writes the summaries instead (a few cents per meeting, best quality).
# ANTHROPIC_API_KEY=your_anthropic_key

# ---------- ADVANCED (leave alone unless needed) ----------
# AI_PROVIDER=gemini            # force one: gemini, groq or anthropic (default: Groq for normal meetings, Gemini for long ones)
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# CLAUDE_MODEL=claude-sonnet-5-5
